// use prisma-8


model User{
    Id                Int                 @id @default(autoincrement())       
    name              String          
    email             String              @unique

}

model Short_URL {
  // Fields
  Id                  Int                 @id @default(autoincrement())
  original_url        String          
  ShortCode           String              @unique
  status              Boolean   

  no_visitors         Int
}

